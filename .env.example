# Dashboard
# https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/docker.md#running-the-dashboard

# API Server
# https://github.com/NousResearch/hermes-agent/blob/main/website/docs/user-guide/features/api-server.md#environment-variables

# Slack
# https://hermes-agent.nousresearch.com/docs/user-guide/messaging/slack

# Web Search
# https://hermes-agent.nousresearch.com/docs/user-guide/features/web-search#backends

# LLM Wiki
# https://hermes-agent.nousresearch.com/docs/user-guide/skills/bundled/research/research-llm-wiki#wiki-location

# Hermes configs
BRAVE_SEARCH_API_KEY=dummy-brave-api-key
SLACK_BOT_TOKEN=dummy-slack-bot-token
SLACK_APP_TOKEN=dummy-slack-app-token
SLACK_ALLOWED_USERS=U1234567890,U0987654321
SLACK_HOME_CHANNEL=C1234567890
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=dummy-password-hash
HERMES_DASHBOARD_BASIC_AUTH_SECRET=dummy-basic-auth-secret
FIRECRAWL_API_KEY=dummy-firecrawl-api-key
WIKI_PATH=/opt/data/wiki
SEARXNG_URL=http://host.docker.internal:8888
OPENAI_BASE_URL=https://bedrock-mantle.eu-central-1.api.aws/openai/v1
OPENAI_API_KEY=dummy-openai-api-key
OPENAI_API_KEY_FALLBACK=dummy-openai-api-key-fallback

# Leafwiki configs
LEAFWIKI_JWT_SECRET=your-leafwiki-jwt-secret
LEAFWIKI_ADMIN_PASSWORD=your-leafwiki-admin-initial-password
LEAFWIKI_ALLOW_INSECURE=true
LEAFWIKI_HOST=0.0.0.0
LEAFWIKI_PORT=9000
LEAFWIKI_DATA_DIR=/opt/data/leafwiki
LEAFWIKI_RESYNC_FREQ=1m

# Persistent data configs
PERSISTENT_DATA_HOME=/opt/data/efs
ADDITIONAL_PROFILES="home, work"
# Targets listed here are copied to /opt/data and synced by the background service.
PERSISTENT_TARGETS_SYNC=".env, config.yaml, SOUL.md, state.db, kanban.db, projects.db, response_store.db, blogwatcher/, leafwiki/, kanban/, sessions/, cron/, hooks/, skins/"
PERSISTENT_TARGETS_SYNC_FREQ=12h
# Targets listed here are symlinked directly into /opt/data instead
# of being copied via rclone. They are not synced by the background service.
PERSISTENT_TARGETS_LINK="memories/, skills/, wiki/"
